{
  "name": "@acme/utils",
  "version": "2.1.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./string": { "types": "./dist/string.d.ts", "default": "./dist/string.js" },
    "./date": { "types": "./dist/date.d.ts", "default": "./dist/date.js" },
    "./features/*": { "types": "./dist/features/*.d.ts", "default": "./dist/features/*.js" },
    "./internal/*": null
  }
}
